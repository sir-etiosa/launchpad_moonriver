# WalletConnect Cloud project id — free, from https://cloud.walletconnect.com
# Without it, injected wallets still work but QR / mobile pairing will not.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Arc testnet RPC (defaults to the public endpoint if unset)
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io

# Filled in after blockchain/script/Deploy.s.sol runs (Phase 3)
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_ONE_TO_ONE_ADDRESS=
